	CoreEngine::TweenSequence& SetLoops(int count, CoreEngine::TweenLoop type = TweenLoop::Restart);
	CoreEngine::TweenSequence& SetDelay(float seconds);
	CoreEngine::TweenSequence& SetLink(CoreEngine::GameObject@ owner);
	CoreEngine::TweenSequence& SetUpdateType(CoreEngine::TweenUpdate type);
	CoreEngine::TweenSequence& SetId(const string&in id);
	CoreEngine::TweenSequence& OnComplete(CoreEngine::TweenCallback@ callback);
	void Kill(bool complete = false);
	CoreEngine::TweenHandle get_handle() const property;
}
