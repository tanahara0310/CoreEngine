class TweenHandle {
	TweenHandle();
	CoreEngine::TweenHandle& SetEase(CoreEngine::EaseType ease);
	CoreEngine::TweenHandle& SetDelay(float seconds);
	CoreEngine::TweenHandle& SetLoops(int count, CoreEngine::TweenLoop type = TweenLoop::Restart);
	CoreEngine::TweenHandle& SetLink(CoreEngine::GameObject@ owner);
	CoreEngine::TweenHandle& SetUpdateType(CoreEngine::TweenUpdate type);
	CoreEngine::TweenHandle& SetId(const string&in id);
	CoreEngine::TweenHandle& OnComplete(CoreEngine::TweenCallback@ callback);
	CoreEngine::TweenHandle& OnStepComplete(CoreEngine::TweenCallback@ callback);
	CoreEngine::TweenHandle& OnUpdate(CoreEngine::TweenProgressCallback@ callback);
	void Kill(bool complete = false);
	void Complete();
	bool get_isActive() const property;
	float get_progress() const property;
}
class TweenSequence {
