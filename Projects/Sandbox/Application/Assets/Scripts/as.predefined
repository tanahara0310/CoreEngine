	CoreEngine::UIImage@ get_uiImage() property;
	CoreEngine::UIImage@ SpawnUIImage(const string&in texturePath, const string&in name) const;
	CoreEngine::UIButton@ get_uiButton() property;
	CoreEngine::Animator@ get_animator() property;
	CoreEngine::AudioListener@ get_audioListener() property;
	CoreEngine::AudioSource@ get_audioSource() property;
	CoreEngine::Camera@ get_camera() property;
	CoreEngine::CharacterController@ get_characterController() property;
	CoreEngine::GpuParticleSystem@ get_gpuParticleSystem() property;
	CoreEngine::Light@ get_light() property;
	CoreEngine::Material@ get_material() property;
	CoreEngine::MeshRenderer@ get_meshRenderer() property;
	CoreEngine::ParticleSystem@ get_particleSystem() property;
	CoreEngine::PhysicsMaterial@ get_physicsMaterial() property;
	CoreEngine::RectTransform@ get_rectTransform() property;
	CoreEngine::Rigidbody@ get_rigidbody() property;
	CoreEngine::SkeletonSocket@ get_skeletonSocket() property;
	CoreEngine::SkyBox@ get_skyBox() property;
	CoreEngine::SpriteRenderer@ get_spriteRenderer() property;
	CoreEngine::Text3DRenderer@ get_text3DRenderer() property;
	CoreEngine::UISlider@ get_uiSlider() property;
