	EaseInOutCubic = 6,
	EaseInQuart = 7,
	EaseOutQuart = 8,
	EaseInOutQuart = 9,
	EaseInQuint = 10,
	EaseOutQuint = 11,
	EaseInOutQuint = 12,
	EaseInSine = 13,
	EaseOutSine = 14,
	EaseInOutSine = 15,
	EaseInExpo = 16,
	EaseOutExpo = 17,
	EaseInOutExpo = 18,
	EaseInCirc = 19,
	EaseOutCirc = 20,
	EaseInOutCirc = 21,
	EaseInBack = 22,
	EaseOutBack = 23,
	EaseInOutBack = 24,
	EaseInElastic = 25,
	EaseOutElastic = 26,
