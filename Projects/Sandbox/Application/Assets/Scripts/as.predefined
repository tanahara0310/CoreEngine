	bool AddComponent(const string&in typeName);
	bool RemoveComponent(const string&in typeName);
	bool HasComponent(const string&in typeName) const;
	CoreEngine::GameObject@[]@ GetChildren() const;
	CoreEngine::GameObject@ InstantiatePrefab(const string&in prefabPath, const string&in name) const;
	CoreEngine::Collider@ get_collider() property;
	CoreEngine::UIText@ get_uiText() property;
