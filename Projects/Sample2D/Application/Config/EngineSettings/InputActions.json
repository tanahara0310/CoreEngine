{
    "version": "1.0",
    "actions": [
        {
            "id": "MoveLeft",
            "display": "左へ",
            "context": "Game",
            "defaults": [
                "Key:A",
                "Key:Left",
                "Axis:LeftStickX-",
                "Gamepad:DPadLeft"
            ]
        },
        {
            "id": "MoveRight",
            "display": "右へ",
            "context": "Game",
            "defaults": [
                "Key:D",
                "Key:Right",
                "Axis:LeftStickX+",
                "Gamepad:DPadRight"
            ]
        },
        {
            "id": "Jump",
            "display": "跳ぶ",
            "context": "Game",
            "defaults": [
                "Key:Space",
                "Key:W",
                "Key:Up",
                "Gamepad:A"
            ]
        },
        {
            "id": "Restart",
            "display": "やり直す",
            "context": "Game",
            "defaults": [
                "Key:R",
                "Gamepad:Y"
            ]
        },
        {
            "id": "UINavigateUp",
            "display": "上へ（UI）",
            "context": "UI",
            "defaults": [
                "Key:Up",
                "Axis:LeftStickY+",
                "Gamepad:DPadUp"
            ]
        },
        {
            "id": "UINavigateDown",
            "display": "下へ（UI）",
            "context": "UI",
            "defaults": [
                "Key:Down",
                "Axis:LeftStickY-",
                "Gamepad:DPadDown"
            ]
        },
        {
            "id": "UINavigateLeft",
            "display": "左へ（UI）",
            "context": "UI",
            "defaults": [
                "Key:Left",
                "Axis:LeftStickX-",
                "Gamepad:DPadLeft"
            ]
        },
        {
            "id": "UINavigateRight",
            "display": "右へ（UI）",
            "context": "UI",
            "defaults": [
                "Key:Right",
                "Axis:LeftStickX+",
                "Gamepad:DPadRight"
            ]
        },
        {
            "id": "UIConfirm",
            "display": "決定",
            "context": "UI",
            "defaults": [
                "Key:Enter",
                "Gamepad:A"
            ]
        },
        {
            "id": "UICancel",
            "display": "戻る",
            "context": "UI",
            "defaults": [
                "Key:Escape",
                "Gamepad:B"
            ]
        },
        {
            "id": "Pause",
            "display": "ポーズ",
            "context": "Game|UI",
            "defaults": [
                "Key:Escape",
                "Gamepad:Start"
            ]
        }
    ]
}
