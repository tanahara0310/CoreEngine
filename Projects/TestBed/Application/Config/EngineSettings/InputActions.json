{
    "version": "1.0",
    "actions": [
        {
            "id": "MoveForward",
            "display": "前進",
            "context": "Game",
            "defaults": [
                "Key:W",
                "Axis:LeftStickY+",
                "Gamepad:DPadUp"
            ]
        },
        {
            "id": "MoveBack",
            "display": "後退",
            "context": "Game",
            "defaults": [
                "Key:S",
                "Axis:LeftStickY-",
                "Gamepad:DPadDown"
            ]
        },
        {
            "id": "MoveLeft",
            "display": "左移動",
            "context": "Game",
            "defaults": [
                "Key:A",
                "Axis:LeftStickX-",
                "Gamepad:DPadLeft"
            ]
        },
        {
            "id": "MoveRight",
            "display": "右移動",
            "context": "Game",
            "defaults": [
                "Key:D",
                "Axis:LeftStickX+",
                "Gamepad:DPadRight"
            ]
        },
        {
            "id": "Jump",
            "display": "ジャンプ",
            "context": "Game",
            "defaults": [
                "Key:Space",
                "Gamepad:A"
            ]
        },
        {
            "id": "Sprint",
            "display": "ダッシュ",
            "context": "Game",
            "defaults": [
                "Key:LShift",
                "Gamepad:LeftThumb"
            ]
        },
        {
            "id": "Attack",
            "display": "攻撃",
            "context": "Game",
            "defaults": [
                "Mouse:Left",
                "Gamepad:X"
            ]
        },
        {
            "id": "Interact",
            "display": "インタラクト",
            "context": "Game",
            "defaults": [
                "Key:E",
                "Gamepad:B"
            ]
        },
        {
            "id": "LookUp",
            "display": "視点を上へ",
            "context": "Game",
            "defaults": [
                "Key:Up",
                "Axis:RightStickY+"
            ]
        },
        {
            "id": "LookDown",
            "display": "視点を下へ",
            "context": "Game",
            "defaults": [
                "Key:Down",
                "Axis:RightStickY-"
            ]
        },
        {
            "id": "LookLeft",
            "display": "視点を左へ",
            "context": "Game",
            "defaults": [
                "Key:Left",
                "Axis:RightStickX-"
            ]
        },
        {
            "id": "LookRight",
            "display": "視点を右へ",
            "context": "Game",
            "defaults": [
                "Key:Right",
                "Axis:RightStickX+"
            ]
        },
        {
            "id": "UINavigateUp",
            "display": "UI上",
            "context": "UI",
            "defaults": [
                "Key:Up",
                "Axis:LeftStickY+",
                "Gamepad:DPadUp"
            ]
        },
        {
            "id": "UINavigateDown",
            "display": "UI下",
            "context": "UI",
            "defaults": [
                "Key:Down",
                "Axis:LeftStickY-",
                "Gamepad:DPadDown"
            ]
        },
        {
            "id": "UINavigateLeft",
            "display": "UI左",
            "context": "UI",
            "defaults": [
                "Key:Left",
                "Axis:LeftStickX-",
                "Gamepad:DPadLeft"
            ]
        },
        {
            "id": "UINavigateRight",
            "display": "UI右",
            "context": "UI",
            "defaults": [
                "Key:Right",
                "Axis:LeftStickX+",
                "Gamepad:DPadRight"
            ]
        },
        {
            "id": "UIConfirm",
            "display": "UI決定",
            "context": "UI",
            "defaults": [
                "Key:Enter",
                "Gamepad:A",
                "Key:Space"
            ]
        },
        {
            "id": "UICancel",
            "display": "UIキャンセル",
            "context": "UI",
            "defaults": [
                "Key:Escape",
                "Gamepad:B"
            ]
        },
        {
            "id": "Pause",
            "display": "ポーズ",
            "context": "Game|UI",
            "defaults": [
                "Key:Escape",
                "Gamepad:Start"
            ]
        },
        {
            "id": "SwitchView",
            "display": "視点の切り替え",
            "context": "Game",
            "defaults": [
                "Key:Tab",
                "Gamepad:Y"
            ]
        },
        {
            "id": "MoveUp",
            "display": "上昇",
            "context": "Game",
            "defaults": [
                "Key:E",
                "Axis:RightTrigger+"
            ]
        },
        {
            "id": "MoveDown",
            "display": "下降",
            "context": "Game",
            "defaults": [
                "Key:Q",
                "Axis:LeftTrigger+"
            ]
        },
        {
            "id": "PlacePlayer",
            "display": "プレイヤーを降ろす",
            "context": "Game",
            "defaults": [
                "Key:F",
                "Gamepad:X"
            ]
        }
    ]
}
