/// @file ShaderMath.hlsli
/// @brief 全シェーダー共通の数学定数
/// @details 円周率などをファイルごとに書き写すと、桁数のばらつき（3.14159f / 3.14159265f /
///          3.14159265359f）がそのまま結果のばらつきになるため、ここに一本化する。
///          値だけを持つヘッダなのでどのステージ（VS/PS/CS/lib）からでも include できる。

#ifndef SHADER_MATH_HLSLI
#define SHADER_MATH_HLSLI

// ===================================================================
// 円周率
// ===================================================================
static const float PI = 3.14159265358979323846f;
static const float TWO_PI = 6.28318530717958647692f;
static const float FOUR_PI = 12.56637061435917295384f;
static const float HALF_PI = 1.57079632679489661923f;

/// @brief 1/π。ランバート BRDF（albedo/π）など除算を避けたい箇所で使う
static const float INV_PI = 0.31830988618379067154f;
static const float INV_TWO_PI = 0.15915494309189533577f;
/// @brief 1/4π。等方位相関数の正規化係数
static const float INV_FOUR_PI = 0.07957747154594766788f;

// ===================================================================
// 角度変換
// ===================================================================
static const float DEG_TO_RAD = 0.01745329251994329577f;
static const float RAD_TO_DEG = 57.29577951308232087680f;

// ===================================================================
// 数値安定用の微小値
// ===================================================================
/// @brief 0除算防止用の一般的な下駄（PBR の分母など）
static const float EPSILON = 0.00001f;

#endif // SHADER_MATH_HLSLI
