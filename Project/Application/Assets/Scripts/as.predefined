// CoreEngine が起動時に、スクリプトへ登録した型と関数から書き出す補完用の宣言（手で書き換えない）
enum InputAction {
	MoveForward = 0,
	MoveBack = 1,
	MoveLeft = 2,
	MoveRight = 3,
	Jump = 4,
	Attack = 5,
	Interact = 6,
	UIConfirm = 7,
	UICancel = 8,
	Pause = 9,
	EditorGizmoTranslate = 10,
	EditorGizmoRotate = 11,
	EditorGizmoScale = 12
}
class array<T> {
	T& opIndex(uint index);
	const T& opIndex(uint index) const;
	uint opForBegin() const;
	bool opForEnd(uint) const;
	uint opForNext(uint) const;
	const T& opForValue0(uint index) const;
	uint opForValue1(uint index) const;
	T[]& opAssign(const T[]&in);
	void insertAt(uint index, const T&in value);
	void insertAt(uint index, const T[]&inout arr);
	void insertLast(const T&in value);
	void removeAt(uint index);
	void removeLast();
	void removeRange(uint start, uint count);
	uint length() const;
	void reserve(uint length);
	void resize(uint length);
	void sortAsc();
	void sortAsc(uint startAt, uint count);
	void sortDesc();
	void sortDesc(uint startAt, uint count);
	void reverse();
	int find(const T&in value) const;
	int find(uint startAt, const T&in value) const;
	int findByRef(const T&in value) const;
	int findByRef(uint startAt, const T&in value) const;
	bool opEquals(const T[]&in) const;
	bool isEmpty() const;
	void sort(T[]::less&in, uint startAt = 0, uint count = uint(-1));
	funcdef bool less(const T&in a, const T&in b);
}
class string {
	string();
	string(const string&in);
	string& opAssign(const string&in);
	string& opAddAssign(const string&in);
	bool opEquals(const string&in) const;
	int opCmp(const string&in) const;
	string opAdd(const string&in) const;
	uint length() const;
	void resize(uint);
	bool isEmpty() const;
	uint8& opIndex(uint);
	const uint8& opIndex(uint) const;
	string& opAssign(double);
	string& opAddAssign(double);
	string opAdd(double) const;
	string opAdd_r(double) const;
	string& opAssign(float);
	string& opAddAssign(float);
	string opAdd(float) const;
	string opAdd_r(float) const;
	string& opAssign(int64);
	string& opAddAssign(int64);
	string opAdd(int64) const;
	string opAdd_r(int64) const;
	string& opAssign(uint64);
	string& opAddAssign(uint64);
	string opAdd(uint64) const;
	string opAdd_r(uint64) const;
	string& opAssign(bool);
	string& opAddAssign(bool);
	string opAdd(bool) const;
	string opAdd_r(bool) const;
	string substr(uint start = 0, int count = -1) const;
	int findFirst(const string&in, uint start = 0) const;
	int findFirstOf(const string&in, uint start = 0) const;
	int findFirstNotOf(const string&in, uint start = 0) const;
	int findLast(const string&in, int start = -1) const;
	int findLastOf(const string&in, int start = -1) const;
	int findLastNotOf(const string&in, int start = -1) const;
	void insert(uint pos, const string&in other);
	void erase(uint pos, int count = -1);
}
class Vector2 {
	Vector2();
	Vector2(float x, float y);
	Vector2 opAdd(const Vector2&in) const;
	Vector2 opSub(const Vector2&in) const;
	Vector2 opMul(float) const;
	Vector2 opMul(const Vector2&in) const;
	Vector2 opMul_r(float) const;
	Vector2 opDiv(float) const;
	Vector2 opNeg() const;
	Vector2& opAddAssign(const Vector2&in);
	Vector2& opSubAssign(const Vector2&in);
	Vector2& opMulAssign(float);
	Vector2& opDivAssign(float);
	bool opEquals(const Vector2&in) const;
	float x;
	float y;
}
class Vector3 {
	Vector3();
	Vector3(float x, float y, float z);
	Vector3 opAdd(const Vector3&in) const;
	Vector3 opSub(const Vector3&in) const;
	Vector3 opMul(float) const;
	Vector3 opMul(const Vector3&in) const;
	Vector3 opMul_r(float) const;
	Vector3 opDiv(float) const;
	Vector3 opNeg() const;
	Vector3& opAddAssign(const Vector3&in);
	Vector3& opSubAssign(const Vector3&in);
	Vector3& opMulAssign(float);
	Vector3& opDivAssign(float);
	bool opEquals(const Vector3&in) const;
	float x;
	float y;
	float z;
}
class Vector4 {
	Vector4();
	Vector4(float x, float y, float z, float w);
	Vector4 opAdd(const Vector4&in) const;
	Vector4 opSub(const Vector4&in) const;
	Vector4 opMul(float) const;
	Vector4 opMul(const Vector4&in) const;
	Vector4 opMul_r(float) const;
	Vector4 opDiv(float) const;
	Vector4 opNeg() const;
	Vector4& opAddAssign(const Vector4&in);
	Vector4& opSubAssign(const Vector4&in);
	Vector4& opMulAssign(float);
	Vector4& opDivAssign(float);
	bool opEquals(const Vector4&in) const;
	float x;
	float y;
	float z;
	float w;
}
class GameObject {
	string get_name() const property;
	void set_name(const string&in) property;
	bool get_active() const property;
	void set_active(bool) property;
	bool get_isAlive() const property;
	void Destroy();
	bool opEquals(const GameObject&in) const;
	Transform@ get_transform() property;
}
class Transform {
	bool get_exists() const property;
	Vector3 get_position() const property;
	void set_position(const Vector3&in) property;
	Vector3 get_rotation() const property;
	void set_rotation(const Vector3&in) property;
	Vector3 get_scale() const property;
	void set_scale(const Vector3&in) property;
	Vector3 get_worldPosition() const property;
	void SetParent(Transform@ parent);
	GameObject@ get_gameObject() const property;
}
string formatInt(int64 val, const string&in options = "", uint width = 0);
string formatUInt(uint64 val, const string&in options = "", uint width = 0);
string formatFloat(double val, const string&in options = "", uint width = 0, uint precision = 0);
int64 parseInt(const string&in, uint base = 10, uint&out byteCount = 0);
uint64 parseUInt(const string&in, uint base = 10, uint&out byteCount = 0);
double parseFloat(const string&in, uint&out byteCount = 0);
float fpFromIEEE(uint);
uint fpToIEEE(float);
double fpFromIEEE(uint64);
uint64 fpToIEEE(double);
bool closeTo(float, float, float = 0.00001f);
bool closeTo(double, double, double = 0.0000000001);
float cos(float);
float sin(float);
float tan(float);
float acos(float);
float asin(float);
float atan(float);
float atan2(float, float);
float cosh(float);
float sinh(float);
float tanh(float);
float log(float);
float log10(float);
float pow(float, float);
float sqrt(float);
float ceil(float);
float abs(float);
float floor(float);
float fraction(float);
void throw(const string&in);
string getExceptionInfo();
void Log(const string&in message);
void Warn(const string&in message);
void Error(const string&in message);
float Dot(const Vector2&in, const Vector2&in);
float Cross(const Vector2&in, const Vector2&in);
float Length(const Vector2&in);
float LengthSquared(const Vector2&in);
float Distance(const Vector2&in, const Vector2&in);
Vector2 Normalize(const Vector2&in);
Vector2 Lerp(const Vector2&in, const Vector2&in, float);
float Dot(const Vector3&in, const Vector3&in);
Vector3 Cross(const Vector3&in, const Vector3&in);
float Length(const Vector3&in);
float LengthSquared(const Vector3&in);
float Distance(const Vector3&in, const Vector3&in);
float DistanceSquared(const Vector3&in, const Vector3&in);
Vector3 Normalize(const Vector3&in);
Vector3 Lerp(const Vector3&in, const Vector3&in, float);
Vector3 Clamp(const Vector3&in, const Vector3&in, const Vector3&in);
float Dot(const Vector4&in, const Vector4&in);
float Length(const Vector4&in);
float LengthSquared(const Vector4&in);
Vector4 Normalize(const Vector4&in);
Vector4 Lerp(const Vector4&in, const Vector4&in, float);
float Lerp(float, float, float);
float Clamp(float, float, float);
int Clamp(int, int, int);
float Saturate(float);
float Min(float, float);
float Max(float, float);
int Min(int, int);
int Max(int, int);
namespace Time {
float DeltaTime();
float UnscaledDeltaTime();
float TimeSinceStartup();
float UnscaledTimeSinceStartup();
uint64 FrameCount();
float TimeScale();
bool IsPaused();
}
namespace Input {
bool IsActionPressed(InputAction);
bool IsActionTriggered(InputAction);
bool IsActionReleased(InputAction);
float GetAxisValue(InputAction);
bool IsGamepadConnected();
}
