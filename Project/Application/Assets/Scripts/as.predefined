// CoreEngine が起動時に、スクリプトへ登録した型と関数から書き出す補完用の宣言（手で書き換えない）
enum EaseType {
	Linear = 0,
	EaseInQuad = 1,
	EaseOutQuad = 2,
	EaseInOutQuad = 3,
	EaseInCubic = 4,
	EaseOutCubic = 5,
	EaseInOutCubic = 6,
	EaseInQuart = 7,
	EaseOutQuart = 8,
	EaseInOutQuart = 9,
	EaseInQuint = 10,
	EaseOutQuint = 11,
	EaseInOutQuint = 12,
	EaseInSine = 13,
	EaseOutSine = 14,
	EaseInOutSine = 15,
	EaseInExpo = 16,
	EaseOutExpo = 17,
	EaseInOutExpo = 18,
	EaseInCirc = 19,
	EaseOutCirc = 20,
	EaseInOutCirc = 21,
	EaseInBack = 22,
	EaseOutBack = 23,
	EaseInOutBack = 24,
	EaseInElastic = 25,
	EaseOutElastic = 26,
	EaseInOutElastic = 27,
	EaseInBounce = 28,
	EaseOutBounce = 29,
	EaseInOutBounce = 30
}
