}
class GameObject {
	string get_name() const property;
	void set_name(const string&in) property;
	bool get_active() const property;
	void set_active(bool) property;
	bool get_isAlive() const property;
	void Destroy();
	bool opEquals(const GameObject&in) const;
	Transform@ get_transform() property;
	GameObject@ FindObject(const string&in name) const;
	GameObject@ InstantiatePrefab(const string&in prefabPath, const string&in name) const;
	UIText@ get_uiText() property;
	UIText@ SpawnUIText(const string&in fontName, const string&in text, const string&in name) const;
	UIImage@ get_uiImage() property;
	UIImage@ SpawnUIImage(const string&in texturePath, const string&in name) const;
	Material@ get_material() property;
	ModelRenderPool@ get_modelRenderPool() property;
	TileWater@ get_tileWater() property;
}
class Transform {
	bool get_exists() const property;
	Vector3 get_position() const property;
	void set_position(const Vector3&in) property;
	Vector3 get_rotation() const property;
	void set_rotation(const Vector3&in) property;
	Vector3 get_scale() const property;
	void set_scale(const Vector3&in) property;
	Vector3 get_worldPosition() const property;
	void SetParent(Transform@ parent);
	void UpdateMatrix();
	GameObject@ get_gameObject() const property;
}
class TweenHandle {
	TweenHandle();
	TweenHandle& SetEase(EaseType ease);
	TweenHandle& SetDelay(float seconds);
	TweenHandle& SetLoops(int count, TweenLoop type = TweenLoop::Restart);
	TweenHandle& SetLink(GameObject@ owner);
	TweenHandle& SetUpdateType(TweenUpdate type);
	TweenHandle& SetId(const string&in id);
	TweenHandle& OnComplete(TweenCallback@ callback);
	TweenHandle& OnStepComplete(TweenCallback@ callback);
	TweenHandle& OnUpdate(TweenProgressCallback@ callback);
	void Kill(bool complete = false);
	void Complete();
	bool get_isActive() const property;
	float get_progress() const property;
}
class TweenSequence {
	TweenSequence();
	TweenSequence& Append(const TweenHandle&in tween);
	TweenSequence& Join(const TweenHandle&in tween);
	TweenSequence& AppendInterval(float seconds);
	TweenSequence& AppendCallback(TweenCallback@ action);
	TweenSequence& SetLoops(int count, TweenLoop type = TweenLoop::Restart);
	TweenSequence& SetDelay(float seconds);
	TweenSequence& SetLink(GameObject@ owner);
	TweenSequence& SetUpdateType(TweenUpdate type);
	TweenSequence& SetId(const string&in id);
	TweenSequence& OnComplete(TweenCallback@ callback);
	void Kill(bool complete = false);
	TweenHandle get_handle() const property;
}
