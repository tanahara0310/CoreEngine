{
    "version": "1.0",
    "actions": [
        {
            "id": "MoveForward",
            "display": "前進",
            "defaults": [
                "Key:W",
                "Key:Up",
                "Axis:LeftStickY+",
                "Gamepad:DPadUp"
            ]
        },
        {
            "id": "MoveBack",
            "display": "後退",
            "defaults": [
                "Key:S",
                "Key:Down",
                "Axis:LeftStickY-",
                "Gamepad:DPadDown"
            ]
        },
        {
            "id": "MoveLeft",
            "display": "左移動",
            "defaults": [
                "Key:A",
                "Key:Left",
                "Axis:LeftStickX-",
                "Gamepad:DPadLeft"
            ]
        },
        {
            "id": "MoveRight",
            "display": "右移動",
            "defaults": [
                "Key:D",
                "Key:Right",
                "Axis:LeftStickX+",
                "Gamepad:DPadRight"
            ]
        },
        {
            "id": "Jump",
            "display": "ジャンプ",
            "defaults": [
                "Key:Space",
                "Gamepad:A"
            ]
        },
        {
            "id": "Attack",
            "display": "攻撃",
            "defaults": [
                "Mouse:Left",
                "Gamepad:X"
            ]
        },
        {
            "id": "Interact",
            "display": "インタラクト",
            "defaults": [
                "Key:E",
                "Gamepad:B"
            ]
        },
        {
            "id": "UIConfirm",
            "display": "UI決定",
            "defaults": [
                "Key:Enter",
                "Gamepad:A"
            ]
        },
        {
            "id": "UICancel",
            "display": "UIキャンセル",
            "defaults": [
                "Key:Escape",
                "Gamepad:B"
            ]
        },
        {
            "id": "Pause",
            "display": "ポーズ",
            "defaults": [
                "Key:Escape",
                "Gamepad:Start"
            ]
        },
        {
            "id": "EditorGizmoTranslate",
            "display": "ギズモ：移動",
            "defaults": [
                "Key:W"
            ]
        },
        {
            "id": "EditorGizmoRotate",
            "display": "ギズモ：回転",
            "defaults": [
                "Key:E"
            ]
        },
        {
            "id": "EditorGizmoScale",
            "display": "ギズモ：拡縮",
            "defaults": [
                "Key:R"
            ]
        }
    ]
}
